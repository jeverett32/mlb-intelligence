# ─────────────────────────────────────────────────────────────────────────────
# Kalshi API credentials
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Go to https://kalshi.com/account/profile and generate an API key.
#    You will receive two things:
#
#    a) A Key ID — looks like:  xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#       Paste it below as KALSHI_KEY_ID.
#
#    b) A PEM private key — looks like:
#          -----BEGIN PRIVATE KEY-----
#          MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEA...
#          (many lines of base64)
#          -----END PRIVATE KEY-----
#       Copy the ENTIRE block (including the -----BEGIN/END----- lines)
#       and save it to a file called kalshi-key.pem at the project root.
#       The path to that file goes in KALSHI_KEY_PATH below.
#
# 2. Copy this file to .env (never commit .env to git):
#       cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

KALSHI_KEY_ID=your-key-id-here
KALSHI_KEY_PATH=kalshi-key.pem

# Use "demo" for paper trading (separate demo keys required from demo-api.kalshi.co)
# Use "prod" for real money
KALSHI_ENV=prod
