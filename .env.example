# MLB Pipeline — environment variables
#
# SECURITY:
# - Do not commit real secrets, hostnames, or IP addresses.
# - Keep this file as a TEMPLATE only (placeholders / blank values).
# - Copy to .env and fill in values locally/on the server.

# ------------------------------
# Postgres (required)
# ------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Max connections for the app-side psycopg2 pool (optional)
DB_POOL_MAX=

# ------------------------------
# Encryption-at-rest (recommended)
# ------------------------------
# Fernet key used to encrypt sensitive fields stored in the DB (e.g. Kalshi key_id).
# Generate with:
#   python3 - <<'PY'
#   from cryptography.fernet import Fernet
#   print(Fernet.generate_key().decode())
#   PY
ENCRYPTION_KEY=

# ------------------------------
# MLB season selection (optional)
# ------------------------------
# If unset, defaults to the current year.
MLB_SEASON=

# ------------------------------
# Odds API (optional)
# ------------------------------
# Used if the configured odds source requires an API key.
ODDS_API_KEY=

# ------------------------------
# Dashboard / app settings (optional)
# ------------------------------
# Bootstrap the first admin account (email address).
MLB_BOOTSTRAP_ADMIN_EMAIL=

# Set to "true" when serving behind HTTPS (controls cookie security flags).
MLB_COOKIE_SECURE=

# Optional outbound alerting/webhooks.
MLB_ALERT_WEBHOOK=

# Optional base URL if you deploy behind a reverse proxy.
MLB_BASE_URL=

# ------------------------------
# Kalshi execution controls (optional)
# ------------------------------
# Environment selector (implementation-specific; commonly "prod" or "demo").
KALSHI_ENV=

# Execution slippage guardrails / thresholds.
KALSHI_ORDER_SLIPPAGE_CENTS=
KALSHI_EXECUTION_MIN_EDGE=

# Switch between Kalshi order endpoint variants when needed.
KALSHI_ORDER_ENDPOINT=

# Optional: directory where PEM keys live on the deployed machine.
KALSHI_SECRETS_DIR=

# Optional legacy/global Kalshi creds.
# Note: In the current pipeline, per-user Kalshi creds are usually stored in Postgres (kalshi_accounts).
KALSHI_KEY_ID=
KALSHI_KEY_PATH=

# ------------------------------
# SSH helper (optional)
# ------------------------------
# Used by homelab.py for one-shot SSH debugging.
# Preferred vars: APP_SSH_* for MLB app LXC entry point (not Proxmox host node).
APP_SSH_HOST=
APP_SSH_PORT=
APP_SSH_USER=
APP_SSH_PASSWORD=
APP_SSH_KEY_PATH=
APP_SSH_KEY_PASSPHRASE=

# DB LXC SSH entry point. Set these explicitly even when creds match APP_SSH_*.
DB_SSH_HOST=
DB_SSH_PORT=
DB_SSH_USER=
DB_SSH_PASSWORD=
DB_SSH_KEY_PATH=
DB_SSH_KEY_PASSPHRASE=

# ------------------------------
# Optional: Signal follower integration (only if you use it)
# ------------------------------
MLBI_API_BASE_URL=
MLBI_API_TOKEN=
MLBI_POLL_SECONDS=
MLBI_SIGNAL_LIMIT=
MLBI_STATE_FILE=
