# =============================================================================
# MLB Betting Pipeline — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.
# =============================================================================


# ── Kalshi API ────────────────────────────────────────────────────────────────
# Generate an API key at https://kalshi.com/account/profile
# You'll receive a Key ID and a PEM private key file.

KALSHI_KEY_ID=
KALSHI_KEY_PATH=

# "prod" for real money, "demo" for paper trading (needs separate demo keys
# from https://demo-api.kalshi.co)
KALSHI_ENV=


# ── The Odds API ──────────────────────────────────────────────────────────────
# Free tier available at https://the-odds-api.com (500 requests/month)
# Used as fallback when SBR odds scraping is unavailable.

ODDS_API_KEY=


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection details for the mlb database on your Postgres server.
# Default values below match the homelab setup described in the README.

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
