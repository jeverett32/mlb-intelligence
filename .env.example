# =============================================================================
# MLB Betting Pipeline — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.
# =============================================================================


# ── Kalshi API ────────────────────────────────────────────────────────────────
# Generate an API key at https://kalshi.com/account/profile
# You'll receive a Key ID and a PEM private key file.

KALSHI_KEY_ID=
KALSHI_KEY_PATH=

# "prod" for real money, "demo" for paper trading (needs separate demo keys
# from https://demo-api.kalshi.co)
KALSHI_ENV=


# ── The Odds API ──────────────────────────────────────────────────────────────
# Free tier available at https://the-odds-api.com (500 requests/month)
# Used as fallback when SBR odds scraping is unavailable.

ODDS_API_KEY=


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection details for the mlb database on your Postgres server.
# Default values below match the homelab setup described in the README.

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=


# -- Homelab SSH (optional helper for homelab.py) ------------------------------
# Proxmox SSH entrypoint (host machine, not the individual LXCs).

HOMELAB_HOST=
HOMELAB_PORT=
HOMELAB_USER=
HOMELAB_PASSWORD=
# HOMELAB_SSH_KEY_PATH=
# HOMELAB_SSH_KEY_PASSPHRASE=

# Default container IDs used by homelab.py subcommands.
HOMELAB_APP_CTID=
HOMELAB_DB_CTID=


# ── Alerts (optional) ─────────────────────────────────────────────────────────
# Discord webhook URL; bet failures and batch aborts are posted here.
MLB_ALERT_WEBHOOK=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Set to 1 when serving over HTTPS (e.g. behind Cloudflare Tunnel).
MLB_COOKIE_SECURE=
