# =============================================================================
# MLB Betting Pipeline — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.
# =============================================================================


# ── Kalshi API ────────────────────────────────────────────────────────────────
# Generate an API key at https://kalshi.com/account/profile
# You'll receive a Key ID and a PEM private key file.

KALSHI_KEY_ID=
KALSHI_KEY_PATH=

# "prod" for real money, "demo" for paper trading (needs separate demo keys
# from https://demo-api.kalshi.co)
KALSHI_ENV=

# Order API endpoint. "legacy" uses the endpoint that is known to work here.
# "events" uses /portfolio/events/orders with safe fallback on request-shape
# rejection, but should stay opt-in until verified with real orders.
KALSHI_ORDER_ENDPOINT=


# ── The Odds API ──────────────────────────────────────────────────────────────
# Free tier available at https://the-odds-api.com (500 requests/month)
# Used as fallback when SBR odds scraping is unavailable.

ODDS_API_KEY=


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection details for the mlb database on your Postgres server.
# Default values below match the homelab setup described in the README.

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=


# -- Homelab SSH (homelab.py — connects directly to each LXC) ------------------
# App LXC SSH credentials.

HOMELAB_HOST=
HOMELAB_PORT=
HOMELAB_USER=
HOMELAB_PASSWORD=
# HOMELAB_SSH_KEY_PATH=
# HOMELAB_SSH_KEY_PASSPHRASE=

# DB LXC SSH credentials.
# Host falls back to DB_HOST above if HOMELAB_DB_SSH_HOST is unset.
# User/password fall back to HOMELAB_USER / HOMELAB_PASSWORD if unset.
HOMELAB_DB_SSH_HOST=
# HOMELAB_DB_SSH_PORT=22
# HOMELAB_DB_SSH_USER=root
# HOMELAB_DB_SSH_PASSWORD=your-db-lxc-ssh-password
# HOMELAB_DB_SSH_KEY_PATH=
# HOMELAB_DB_SSH_KEY_PASSPHRASE=


# ── Encryption ───────────────────────────────────────────────────────────────
# Used to encrypt sensitive fields (Kalshi API keys) at rest in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Alerts (optional) ─────────────────────────────────────────────────────────
# Discord webhook URL; bet failures and batch aborts are posted here.
MLB_ALERT_WEBHOOK=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Set to 1 when serving over HTTPS (e.g. behind Cloudflare Tunnel).
MLB_COOKIE_SECURE=
