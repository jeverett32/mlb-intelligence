[Unit]
Description=MLB V2 walk-forward eval — deterministic LGBM (Phase 2.5 style metrics)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=mlb
Group=mlb
WorkingDirectory=/opt/mlb/pipeline
ExecStart=/opt/mlb/pipeline/.venv/bin/python -m models.model_v2.eval
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=.
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=2h
